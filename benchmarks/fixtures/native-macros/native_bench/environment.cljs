(ns native-bench.environment)
(defmacro ns-name [] (list 'quote (:name (:ns &env))))
(defmacro place [] (count &form))
(defmacro annotated [x] (with-meta x {:native true}))
(defmacro wrap [x] `(+ ~x 2))
(js/console.log (str (ns-name)) (str (ns-name)) (str (ns-name)) (str (ns-name)))
(js/console.log (str (ns-name)) (str (ns-name)) (str (ns-name)) (str (ns-name)))
(js/console.log (place) (place) (place) (place))
(js/console.log (annotated (+ 1 41)) (annotated (+ 1 41)))
(js/console.log (wrap 40) (wrap 40))
