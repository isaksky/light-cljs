(ns native-bench.collections)
(defmacro quoted-seq [x] (list 'quote (seq x)))
(defmacro sequence? [x] (seq? (seq x)))
(defmacro empty-seq? [x] (nil? (seq x)))
(defmacro units [x] (count (seq x)))
(js/console.log (pr-str (quoted-seq [1 2]))
                (pr-str (quoted-seq {:a 1}))
                (pr-str (quoted-seq "ab")))
(js/console.log (sequence? [1]) (sequence? {:a 1})
                (sequence? "a") (sequence? (1)))
(js/console.log (empty-seq? nil) (empty-seq? ()) (empty-seq? [])
                (empty-seq? {}) (empty-seq? ""))
(js/console.log (units "😀"))
