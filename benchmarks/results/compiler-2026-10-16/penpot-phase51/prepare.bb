(require '[babashka.fs :as fs] '[babashka.process :as p] '[clojure.string :as str])
(def here (fs/parent *file*))
(def project (fs/file here "project"))
(def repo (fs/file "/Users/admin/src/light-cljs"))
(fs/create-dirs project)
(doseq [directory ["src" "tests" "vendor" "benches"]]
  (p/shell "rsync" "-a" (str (fs/file repo directory) "/") (str (fs/file project directory) "/")))
(doseq [file ["Cargo.toml" "Cargo.lock" "build.rs" "AGENTS.md"]]
  (fs/copy (fs/file repo file) (fs/file project file) {:replace-existing true}))
(fs/create-dirs (fs/file project "research"))
(when-not (fs/exists? (fs/file project "research/clojurescript"))
  (fs/create-sym-link (fs/file project "research/clojurescript") (fs/file repo "research/clojurescript")))
(when-not (fs/exists? (fs/file project "benchmarks"))
  (fs/create-sym-link (fs/file project "benchmarks") (fs/file repo "benchmarks")))
(def path (fs/file project "src/emitter.rs"))
(def original (slurp path))
(def before "        let register_namespaces = self.register_namespaces;\n        // Group once in global ID order.")
(def after "        let register_namespaces = self.register_namespaces;\n        let demand_roots = self.demand_roots;\n        let js_string = |text: &str| {\n            if demand_roots {\n                quoted(text)\n            } else {\n                js_string(text)\n            }\n        };\n        // Group once in global ID order.")
(assert (str/includes? original before))
(spit path (str/replace original before after))
(p/shell {:dir (str project)} "cargo" "fmt")
(println "Prepared compile-time registration quoting in the QuickJS production source; no registration-order change.")
