(require '[babashka.fs :as fs] '[clojure.string :as str])
(def here (fs/parent *file*))
(def original (slurp (fs/file here "runtime-baseline.js")))
(def start (str/index-of original "  function privateStore() {"))
(def end (str/index-of original "  //@unit cells" start))
(assert (and start end))
(def updated (str (subs original 0 start) "  function privateStore() { return new WeakMap(); }\n" (subs original end)))
(spit (fs/file here "runtime-weak-stores.js") updated)
(def start-vector (str/index-of updated "  const vectors = class"))
(def end-vector (str/index-of updated "  //@unit symbols" start-vector))
(assert (and start-vector end-vector))
(spit (fs/file here "runtime-weak-all.js")
  (str (subs updated 0 start-vector) "  const vectors = new WeakMap();\n" (subs updated end-vector)))
