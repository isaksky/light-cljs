(require '[babashka.fs :as fs] '[babashka.process :as p] '[clojure.string :as str])
(def here (fs/parent *file*))
(def project (fs/file here "project"))
(when-not (fs/exists? project)
  (p/shell "cp" "-a" "/private/tmp/light-cljs-phase107/project" (str project)))
(when-not (fs/exists? (fs/file here "v8"))
  (p/shell "cp" "-cR" "/private/tmp/light-cljs-phase108/v8" (str (fs/file here "v8"))))
(spit (fs/file project "Cargo.toml")
  (str/replace (slurp "/private/tmp/light-cljs-phase107/project/Cargo.toml")
    "[patch.crates-io]" (str "[patch.crates-io]\nv8 = { path = \"" (fs/file here "v8") "\" }")))
(p/shell {:dir (str project)} "cargo" "tree" "-p" "v8" "--depth" "0")
