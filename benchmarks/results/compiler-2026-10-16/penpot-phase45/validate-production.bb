(require '[babashka.process :as p] '[babashka.fs :as fs] '[clojure.java.io :as io])
(def here (str (fs/file (fs/parent *file*) "production")))
(fs/create-dirs here)
(defn logged [name & command]
  (println "Validating" name)
  (flush)
  (with-open [out (io/output-stream (str here "/" name ".log"))]
    (apply p/shell {:out out :err :out} command)))
(logged "tests" "cargo" "test")
(logged "clippy" "cargo" "clippy" "--all-targets" "--" "-D" "warnings")
(logged "build" "cargo" "build" "--release")
(p/shell "cargo" "fmt" "--check")
(p/shell "git" "diff" "--check")
(fs/copy "target/release/light-cljs" (str here "/light-cljs") {:replace-existing true})
(fs/copy "src/name_index.rs" (str here "/name_index.rs") {:replace-existing true})
(spit (str here "/implementation.patch") (:out (p/shell {:out :string} "git" "diff" "--binary")))
(p/shell "bb" "benchmarks/penpot.bb" here)
