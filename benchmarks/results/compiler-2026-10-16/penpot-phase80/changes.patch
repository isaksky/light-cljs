+impl<T: Clone> Clone for Chunk<T> {
+    fn clone(&self) -> Self {
+        match self {
+            // Only a shared leaf being written needs entry-level ownership.
+            // Later versions copy references and the single modified entry.
+            Self::Leaf(entries) => Self::SharedLeaf(entries.iter().cloned().map(Rc::new).collect()),
+            Self::SharedLeaf(entries) => Self::SharedLeaf(entries.clone()),
+            Self::Branch { left, right, len } => Self::Branch {
+                left: left.clone(),
+                right: right.clone(),
+                len: *len,
+            },
+        }
+    }
+}
+
+enum Leaf<'a, T> {
+    Dense(&'a [T]),
+    Shared(&'a [Rc<T>]),
+}
+impl<T> Copy for Leaf<'_, T> {}
+impl<T> Clone for Leaf<'_, T> {
+    fn clone(&self) -> Self {
+        *self
+    }
+}
+impl<'a, T> Leaf<'a, T> {
+    fn len(self) -> usize {
+        match self {
+            Self::Dense(entries) => entries.len(),
+            Self::Shared(entries) => entries.len(),
+        }
+    }
+    fn get(self, index: usize) -> Option<&'a T> {
+        match self {
+            Self::Dense(entries) => entries.get(index),
+            Self::Shared(entries) => entries.get(index).map(Rc::as_ref),
+        }
+    }
+}
