(require '[babashka.fs :as fs] '[clojure.string :as str])
(def here (fs/parent *file*))
(def unit (or (first *command-line-args*) "setDeclarationDemand"))
(defn unit-body [path]
  (let [text (slurp path)
        start (str/index-of text (str "  //@unit " unit " "))
        start (or start (str/index-of text (str "  //@unit " unit "\n")))
        end (str/index-of text "  //@unit " (+ start 3))]
    (assert (and start end))
    (->> (str/split-lines (subs text start end))
         (remove #(str/starts-with? (str/trim %) "//@"))
         (str/join "\n"))))
(def before (unit-body "/private/tmp/light-cljs-phase87/project/src/js_runtime.js"))
(def after (unit-body (fs/file here "project/src/js_runtime.js")))
(def baseline (slurp "/private/tmp/light-cljs-phase42/production/main-none.js"))
(assert (= 1 (count (re-seq (re-pattern (java.util.regex.Pattern/quote before)) baseline))))
(assert (= (str/replace baseline before after) (slurp (fs/file here "main-none.js"))))
(spit (fs/file here "output-comparison.edn") (pr-str {:baseline :phase42 :identical-except-runtime-unit unit}))
(println "Output differs only in runtime unit" unit)
