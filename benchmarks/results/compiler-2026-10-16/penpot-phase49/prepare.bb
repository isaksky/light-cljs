(require '[babashka.fs :as fs] '[babashka.process :as p] '[clojure.string :as str])
(def here (fs/parent *file*))
(def project (fs/file here "project"))
(fs/create-dirs project)
(p/shell "rsync" "-a" "--exclude=target" "--exclude=.git"
  "/private/tmp/light-cljs-phase47/project/" (str project "/"))
(def path (fs/file project "src/emitter.rs"))
(def original (slurp path))
(def before "    for &unit in program.strings.iter().flatten() {\n        while matched > 0 && unit != u16::from(needle[matched]) {\n            matched = fallback[matched - 1];\n        }\n        if unit == u16::from(needle[matched]) {\n            matched += 1;\n            if matched == needle.len() {\n                return true;\n            }\n        }\n    }")
(def after "    for units in program.strings.iter() {\n        // Most strings cannot start this generated identifier. Slice::contains\n        // uses a vectorizable search; keep the scalar state machine when a\n        // match crosses a string boundary or a first character is present.\n        if matched == 0 && !units.contains(&u16::from(needle[0])) {\n            continue;\n        }\n        for &unit in units {\n            while matched > 0 && unit != u16::from(needle[matched]) {\n                matched = fallback[matched - 1];\n            }\n            if unit == u16::from(needle[matched]) {\n                matched += 1;\n                if matched == needle.len() {\n                    return true;\n                }\n            }\n        }\n    }")
(assert (str/includes? original before))
(spit path (str/replace original before after))
(fs/copy "/private/tmp/light-cljs-phase47/run-bench.bb" (fs/file here "run-bench.bb") {:replace-existing true})
(p/shell {:dir (str project)} "cargo" "fmt")
(println "Prepared vectorized name-scan prefilter; not built.")
