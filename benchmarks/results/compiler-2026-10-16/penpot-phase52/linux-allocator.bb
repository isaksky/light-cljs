(require '[babashka.fs :as fs] '[babashka.process :as p]
         '[cheshire.core :as json] '[clojure.edn :as edn] '[clojure.string :as str])
(import '[java.security MessageDigest] '[java.time Instant ZoneOffset] '[java.time.format DateTimeFormatter])
(def here (fs/parent *file*))
(def connection (edn/read-string (slurp (fs/file here "linux-connection.edn"))))
(def ssh ["ssh" "-S" (:socket connection) "-o" "BatchMode=yes" "-o" "StrictHostKeyChecking=yes" "-o" "ConnectTimeout=30" "oma"])
(defn remote [s] (apply p/shell {:out :string :err :string :continue true} (conj ssh s)))
(defn quote-sh [s] (str "'" (str/replace (str s) "'" "'\"'\"'") "'"))
(defn hash-path [s] (subs (format "%064x" (BigInteger. 1 (.digest (MessageDigest/getInstance "SHA-256") (.getBytes s "UTF-8")))) 0 12))
(def repo "/Users/admin/src/light-cljs")
(def common (str (fs/real-path (str/trim (:out (p/shell {:dir repo :out :string} "git" "rev-parse" "--path-format=absolute" "--git-common-dir"))))))
(def root (str (fs/real-path repo)))
(def parent (str "/home/isak/LT/r" (hash-path common) "/w" (hash-path root)))
(def start (str (Instant/now)))
(def run-id (str (.format (.withZone (DateTimeFormatter/ofPattern "yyMMddHHmmss") ZoneOffset/UTC) (Instant/now)) "-" (subs (str/replace (str (random-uuid)) "-" "") 0 6)))
(def run (str parent "/" run-id))
(def existing (remote (str "cat " (quote-sh (str parent "/workspace.json")))))
(def ownership {:git-common-dir common :worktree-root root :name "light-cljs" :created-at start})
(when (zero? (:exit existing))
  (let [old (json/parse-string (:out existing) true)]
    (assert (= (select-keys ownership [:git-common-dir :worktree-root])
               (select-keys old [:git-common-dir :worktree-root])) old)))
(assert (#{0 1} (:exit existing)) existing)
(def made (remote (str "mkdir -p " (quote-sh parent) " && mkdir " (quote-sh run) " && mkdir "
                       (str/join " " (map #(quote-sh (str run "/" %)) ["i" "w" "o"])))))
(assert (zero? (:exit made)) made)
(defn upload [local destination]
  (p/shell "scp" "-q" "-o" (str "ControlPath=" (:socket connection)) "-o" "BatchMode=yes"
    "-o" "StrictHostKeyChecking=yes" (str local) (str "oma:" destination)))
(when-not (zero? (:exit existing))
  (spit (fs/file here "workspace.json") (json/generate-string ownership {:pretty true}))
  (upload (fs/file here "workspace.json") (str parent "/workspace.json")))
(def record {:run run :start-time start :state "active" :socket (:socket connection)
             :local-results (str (fs/file here "linux-results")) :purpose "Bundled mimalloc v3 Linux ARM64 C probe; no Rust toolchain installed"})
(spit (fs/file here "linux-run.json") (json/generate-string record {:pretty true}))
(upload (fs/file here "linux-run.json") (str run "/run.json"))
(def package "/Users/admin/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/libmimalloc-sys-0.1.49/c_src/mimalloc/v3")
(p/shell "tar" "-czf" (str (fs/file here "mimalloc-v3.tar.gz")) "-C" package "include" "src")
(upload (fs/file here "mimalloc-v3.tar.gz") (str run "/i/mimalloc-v3.tar.gz"))
(upload (fs/file here "allocator-probe.c") (str run "/i/allocator-probe.c"))
(spit (fs/file here "linux-run.sh")
  "#!/usr/bin/env bash\nset -uo pipefail\nrun=$1\ncd \"$run/i\" || exit $?\nexec >\"$run/o/probe.log\" 2>&1\nuname -m\ngcc --version\ntar -xzf mimalloc-v3.tar.gz || exit $?\ngcc -O2 -DMI_DEBUG=0 -DMI_BUILD_RELEASE -ftls-model=initial-exec -Iinclude -Isrc -c src/static.c -o mimalloc.o && gcc -O2 -Wall -Wextra -Werror -Iinclude allocator-probe.c mimalloc.o -pthread -ldl -o allocator-probe && ./allocator-probe\nrc=$?\nprintf '%s\\n' \"$rc\" >\"$run/o/exit-code.txt\nexit \"$rc\"\n")
;; Keep the output path quote explicit; the script is transferred, never embedded in SSH code.
(spit (fs/file here "linux-run.sh")
  (str/replace (slurp (fs/file here "linux-run.sh")) "exit-code.txt\n" "exit-code.txt\"\n"))
(upload (fs/file here "linux-run.sh") (str run "/w/run.sh"))
(def command (str "bash " (quote-sh (str run "/w/run.sh")) " " (quote-sh run)))
(def result (remote command))
(spit (fs/file here "linux-execution.edn") (pr-str (assoc result :command command)))
(fs/create-dirs (fs/file here "linux-results"))
(p/shell "scp" "-qr" "-o" (str "ControlPath=" (:socket connection)) "-o" "BatchMode=yes" "-o" "StrictHostKeyChecking=yes"
  (str "oma:" run "/o/.") (str (fs/file here "linux-results")))
(assert (not= 255 (:exit result)) result)
(def exit-code (parse-long (str/trim (slurp (fs/file here "linux-results/exit-code.txt")))))
(assert (= exit-code (:exit result)))
(spit (fs/file here "linux-run.json")
  (json/generate-string (assoc record :state "completed" :end-time (str (Instant/now)) :command command :exit exit-code) {:pretty true}))
(upload (fs/file here "linux-run.json") (str run "/run.json"))
(println (slurp (fs/file here "linux-results/probe.log")))
(assert (zero? exit-code))
