(require '[clojure.string :as str])
(def path "/private/tmp/light-cljs-phase44/project/src/v8_bridge.rs")
(def text (slurp path))
(def start (str/index-of text "    fn encode_node<'s>"))
(def end (str/index-of text "    pub(crate) fn decode" start))
(defn replace! [text old new]
  (assert (str/includes? text old) old)
  (str/replace text old new))
(def body
  (-> (subs text start end)
      (replace! "let result = v8::Array::new(scope, 0);" "let nil = v8::null(scope).into();\n        let mut fields = vec![nil, nil, nil];")
      (replace! "put(scope, result, 1, wrapper.into())?;" "fields[1] = wrapper.into();")
      (replace! "put(scope, result, 1, nil.into())?;" "fields[1] = nil.into();")
      (replace! "put(scope, result, 2, metadata)?;" "fields[2] = metadata;")
      (replace! "let items = v8::Array::new(scope, children.len().try_into().map_err(|_| error(\"compiler array too large\"))?);" "let mut items = Vec::with_capacity(children.len());")
      (replace! "for (i, child) in children.iter().enumerate() {" "for child in children.iter() {")
      (replace! "put(scope, items, i as u32, child.into())?;" "items.push(child.into());")
      (replace! "put(scope, result, 3, items.into())?;" "fields.push(v8::Array::new_with_elements(scope, &items).into());")
      (replace! "put(scope, result, 3, value)?;" "fields.push(value);")
      (replace! "put(scope, result, 3, value.into())?;" "fields.push(value.into());")
      (replace! "put(scope, result, 3, namespace)?;" "fields.push(namespace);")
      (replace! "put(scope, result, 4, name)?;" "fields.push(name);")
      (replace! "put(scope, result, 3, payload.into())?;" "fields.push(payload.into());")
      (replace! "let tag = string(scope, tag)?.into(); put(scope, result, 0, tag)?;" "fields[0] = string(scope, tag)?.into();\n        let result = v8::Array::new_with_elements(scope, &fields);")))
(spit path
  (-> (str (subs text 0 start) body (subs text end))
      (replace! "v8::Global<v8::Function>" "v8::Global<v8::ObjectTemplate>")
      (replace! "Local<'s, v8::Function>" "Local<'s, v8::ObjectTemplate>")
      (replace! "v8::FunctionTemplate::new(scope, empty).get_function(scope).ok_or_else(|| error(\"V8 provenance constructor failed\"))?" "v8::FunctionTemplate::new(scope, empty).instance_template(scope)")
      (replace! "constructor.new_instance(scope, &[])" "constructor.new_instance(scope)")
      (replace! "let tag = String::from_utf16(&text_units(scope, tag)?).map_err(|_| error(\"invalid descriptor tag\"))?;"
                "let tag: Local<v8::String> = tag.try_into().map_err(|_| error(\"invalid descriptor tag\"))?;\n        let tag = tag.to_rust_string_lossy(scope);")))
(println "bulk descriptor arrays and cached instance template")
