(require '[babashka.fs :as fs] '[clojure.string :as str])
(def here (fs/parent *file*))
(def file (fs/file here "project/src/main.rs"))
(def original-text (slurp file))
(def before "    let program = light_cljs::compiler::analyze_namespace_entry_with_sources(")
(assert (str/includes? original-text before))
(spit file (-> original-text
  (str/replace "static ALLOCATOR: mimalloc::MiMalloc = mimalloc::MiMalloc;" "static ALLOCATOR: allocation_probe::Allocator = allocation_probe::Allocator;\nmod allocation_probe;")
  (str/replace before (str "    let mut host = flags.host();\n" before))
  (str/replace "        &mut flags.host(),\n        options," "        &mut host,\n        options,")
  (str/replace "    let (program, files) = program?;" "    allocation_probe::report(\"after-analysis\");\n    drop(host);\n    allocation_probe::report(\"after-session-drop\");\n    let (program, files) = program?;\n    eprintln!(\"program-tables exprs={} locals={} globals={} strings={} names={}\", program.exprs.len(), program.locals.len(), program.globals.len(), program.strings.len(), program.named_literals.len());")
  (str/replace "    let prepared = prepare_application(&program, flags.options(&program)?);\n    if let Some(out_dir)" "    let prepared = prepare_application(&program, flags.options(&program)?);\n    allocation_probe::report(\"after-prepare\");\n    if let Some(out_dir)")
  (str/replace "        let output = flags.output(&prepared, esm, &sources)?;" "        let output = flags.output(&prepared, esm, &sources)?;\n        allocation_probe::report(\"after-output\");")))
(spit (fs/file here "run.bb") (-> (slurp "/private/tmp/light-cljs-phase76/run.bb") (str/replace "light-cljs-reader-lookup" "light-cljs-allocation-probe")))
