(require '[babashka.fs :as fs] '[babashka.process :as p] '[cheshire.core :as json]
         '[clojure.string :as str])
(def here (fs/parent *file*))
(def pin "d578f2e8b7bd5938e21cfb6bf15c079e0aa5b738")
(def provenance (json/parse-string (slurp (fs/file here "icu-source.json")) true))
(assert (= pin (:sha provenance)))
(assert (= "https://chromium.googlesource.com/chromium/deps/icu.git" (:submodule_git_url provenance)))
(def root (str "https://chromium.googlesource.com/chromium/deps/icu/+/" pin "/common/"))
(defn fetch [url target]
  (p/shell "curl" "--fail" "--silent" "--show-error" "--location" "--output" (str target) url))
(fetch (str root "?format=JSON") (fs/file here "icu-common.json"))
(fetch (str root "icudtl.dat?format=TEXT") (fs/file here "icudtl.dat.base64"))
(def tree (json/parse-string (str/replace-first (slurp (fs/file here "icu-common.json")) #"^\)\]\}'\n" "") true))
(def expected (:id (first (filter #(= "icudtl.dat" (:name %)) (:entries tree)))))
(assert (and expected (= 40 (count expected))))
(def data (.decode (java.util.Base64/getMimeDecoder) (slurp (fs/file here "icudtl.dat.base64"))))
(def digest (java.security.MessageDigest/getInstance "SHA-1"))
(.update digest (.getBytes (str "blob " (alength data) \u0000) "UTF-8"))
(.update digest data)
(def actual (format "%040x" (java.math.BigInteger. 1 (.digest digest))))
(assert (= expected actual) {:expected expected :actual actual})
(def target (fs/file here "v8/third_party/icu/common/icudtl.dat"))
(fs/create-dirs (fs/parent target))
(with-open [out (clojure.java.io/output-stream target)] (.write out data))
(spit (fs/file here "icu-restoration.edn")
  (pr-str {:commit pin :blob actual :bytes (alength data) :source (str root "icudtl.dat?format=TEXT")}))
(println "Restored exact pinned ICU data" actual (alength data))
