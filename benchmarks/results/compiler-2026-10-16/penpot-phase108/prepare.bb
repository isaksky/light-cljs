(require '[babashka.fs :as fs] '[babashka.process :as p] '[clojure.string :as str])
(def here (fs/parent *file*))
(def project (fs/file here "project"))
(def engine (fs/file here "v8"))
(when-not (fs/exists? project)
  (p/shell "cp" "-a" "/private/tmp/light-cljs-phase107/project" (str project)))
(when-not (fs/exists? engine)
  (p/shell "cp" "-cR" "/Users/admin/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/v8-152.2.0" (str engine)))
(def original (slurp "/private/tmp/light-cljs-phase107/project/Cargo.toml"))
(spit (fs/file project "Cargo.toml")
  (str/replace original "[patch.crates-io]" (str "[patch.crates-io]\nv8 = { path = \"" engine "\" }")))
