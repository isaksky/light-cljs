+pub(crate) fn compiler_root_source(
+    name: &str,
+    unit: Option<usize>,
+    once: bool,
+    location: &str,
+    test: Option<usize>,
+) -> String {
+    let escape = |text: &str| {
+        text.replace('\\', "\\\\")
+            .replace('"', "\\\"")
+            .replace('\n', "\\n")
+            .replace('\r', "\\r")
+    };
+    format!(
+        "rt => globalThis.__lightRegisterUnit(\"{}\",{}, {once}, \"{}\", {})",
+        escape(name),
+        unit.map_or("null".into(), |n| n.to_string()),
+        escape(location),
+        test.map_or("null".into(), |n| n.to_string())
+    )
+}
