(require '[babashka.fs :as fs] '[clojure.string :as s])
(def here (fs/parent *file*))
(defn runtime [phase]
  (->> (s/split-lines (slurp (str "/private/tmp/light-cljs-phase" phase "/project/src/js_runtime.js")))
       (remove #(s/starts-with? (s/triml %) "//@"))
       (s/join "\n") s/trim))
(def before (slurp (fs/file here "baseline-1.js")))
(def after (slurp (fs/file here "candidate-1.js")))
(def old-runtime (runtime 112))
(def new-runtime (runtime 113))
(assert (and (not (neg? (.indexOf before old-runtime)))
             (= (.indexOf before old-runtime) (.lastIndexOf before old-runtime))))
(assert (and (not (neg? (.indexOf after new-runtime)))
             (= (.indexOf after new-runtime) (.lastIndexOf after new-runtime))))
(assert (= (s/replace before old-runtime "RUNTIME") (s/replace after new-runtime "RUNTIME")))
(spit (fs/file here "output-audit.edn") (pr-str {:application-output :byte-identical :difference :embedded-runtime-only}))
(println "Penpot macro expansions and application output are unchanged; only embedded runtime differs")
