(require '[babashka.fs :as fs] '[clojure.string :as str])
(def here (fs/parent *file*))
(def text (slurp "/private/tmp/light-cljs-phase85/project/src/v8_evaluator.rs"))
(def start (str/index-of text "    fn registration(evaluator:"))
(def end (str/index-of text "    #[test]\n    fn namespace_registration_allows_reentry" start))
(assert (and start end))
(def tests (-> (subs text start end)
              (str/replace "V8Evaluator::new" "Evaluator::new")
              (str/replace "        assert_eq!(evaluator.state.namespaces.borrow().hits, 1);\n" "")
              (str/replace "        assert_eq!(evaluator.state.namespaces.borrow().entries.len(), 1024);\n" "")))
(spit (fs/file here "project/src/evaluator.rs")
      (str "\n#[cfg(test)]\nmod namespace_registration_tests {\n    use super::*;\n" tests "}\n") :append true)
(spit (fs/file here "check.bb")
      (-> (slurp "/private/tmp/light-cljs-phase83/check.bb")
          (str/replace "compilation_session::retention_tests" "evaluator::namespace_registration_tests")
          (str/replace " \"LIGHT_V8_MACROS\" \"1\" \"LIGHT_V8_HEAP_BYTES\" \"268435456\"" "")))
(spit (fs/file here "run.bb")
      (-> (slurp "/private/tmp/light-cljs-phase87/run.bb")
          (str/replace "light-cljs-quickjs-shared-storage" "light-cljs-quickjs-namespace-cache")
          (str/replace "QuickJS shared storage" "QuickJS namespace cache")))
