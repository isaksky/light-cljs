(require '[babashka.fs :as fs] '[clojure.string :as str])
(def here (fs/parent *file*))
(def emitter (fs/file here "project/src/emitter.rs"))
(def original-text (slurp emitter))
(def start (str/index-of original-text "// Search the concatenated UTF-16 table"))
(def end (str/index-of original-text "/// An interactive unit:" start))
(assert (and start end))
(def replaced (str (subs original-text 0 start)
  "// This generated binding participates in the same raw-JavaScript hygiene as\n// locals and helpers. It never needs a scan through unrelated prior literals.\nconst UNIT_RUNTIME: &str = \"__lightSessionRuntime\";\n\nfn emit_unit_mode(program: &Program, demand_roots: bool) -> String {\n    emit_js_mode(program, Some(UNIT_RUNTIME), demand_roots, None, None, false, false).0\n}\n\n"
  (subs original-text end)))
(def candidate-text (slurp "/private/tmp/light-cljs-phase70/project/src/emitter.rs"))
(def wrapper-start (str/index-of candidate-text "    // Include the shared-runtime parameter in raw-text hygiene."))
(def wrapper-end (str/index-of candidate-text "    let output = if terse {" wrapper-start))
(def wrapper (subs candidate-text wrapper-start wrapper-end))
(spit emitter (str/replace replaced "    let output = if terse {" (str wrapper "    let output = if terse {")))
(doseq [file ["src/terse.rs" "tests/evaluation/evaluator.rs"]]
  (fs/copy (fs/file "/private/tmp/light-cljs-phase70/project" file) (fs/file here "project" file) {:replace-existing true}))
(spit (fs/file here "run.bb") (-> (slurp "/private/tmp/light-cljs-phase66/run.bb")
  (str/replace "quickjs-unused-form" "quickjs-unit-hygiene")
  (str/replace "QuickJS unused form trial" "QuickJS unit hygiene trial")))
