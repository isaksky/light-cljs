--- /dev/null
+++ b/src/v8_allocator.rs
@@ -0,0 +1,94 @@
+//! Prototype backing-store limit, separate from V8's managed heap limit.
+use crate::evaluator::ExecutionControl;
+use std::{
+    alloc::{Layout, alloc_zeroed, dealloc},
+    ffi::c_void,
+    sync::{
+        Arc, OnceLock,
+        atomic::{AtomicUsize, Ordering},
+    },
+};
+
+pub(crate) struct BufferBudget {
+    used: AtomicUsize,
+    limit: usize,
+    control: ExecutionControl,
+    handle: OnceLock<v8::IsolateHandle>,
+}
+
+impl BufferBudget {
+    pub(crate) fn used(&self) -> usize {
+        self.used.load(Ordering::Relaxed)
+    }
+
+    pub(crate) fn attach(&self, handle: v8::IsolateHandle) {
+        let _ = self.handle.set(handle);
+    }
+
+    fn refuse(&self) -> *mut c_void {
+        self.control.memory_exhausted();
+        if let Some(handle) = self.handle.get() {
+            handle.terminate_execution();
+        }
+        std::ptr::null_mut()
+    }
+}
+
+unsafe extern "C" fn allocate(state: &Arc<BufferBudget>, length: usize) -> *mut c_void {
+    let bytes = length.max(1);
+    let Ok(layout) = Layout::from_size_align(bytes, 8) else {
+        return state.refuse();
+    };
+    #[allow(deprecated)]
+    let reserved = state
+        .used
+        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |used| {
+            used.checked_add(bytes).filter(|next| *next <= state.limit)
+        });
+    if reserved.is_err() {
+        return state.refuse();
+    }
+    let pointer = unsafe { alloc_zeroed(layout) };
+    if pointer.is_null() {
+        state.used.fetch_sub(bytes, Ordering::Relaxed);
+        return state.refuse();
+    }
+    pointer.cast()
+}
+
+unsafe extern "C" fn free(state: &Arc<BufferBudget>, pointer: *mut c_void, length: usize) {
+    if pointer.is_null() {
+        return;
+    }
+    // V8 returns the allocation's original length; allocate validated this layout.
+    let bytes = length.max(1);
+    let layout = unsafe { Layout::from_size_align_unchecked(bytes, 8) };
+    unsafe { dealloc(pointer.cast(), layout) };
+    state.used.fetch_sub(bytes, Ordering::Relaxed);
+}
+
+unsafe extern "C" fn drop_allocator(state: *const Arc<BufferBudget>) {
+    drop(unsafe { Box::from_raw(state.cast_mut()) });
+}
+
+static VTABLE: v8::RustAllocatorVtable<Arc<BufferBudget>> = v8::RustAllocatorVtable {
+    allocate,
+    allocate_uninitialized: allocate,
+    free,
+    drop: drop_allocator,
+};
+
+pub(crate) fn allocator(
+    limit: usize,
+    control: ExecutionControl,
+) -> (v8::UniqueRef<v8::Allocator>, Arc<BufferBudget>) {
+    let budget = Arc::new(BufferBudget {
+        used: AtomicUsize::new(0),
+        limit,
+        control,
+        handle: OnceLock::new(),
+    });
+    let allocator =
+        unsafe { v8::new_rust_allocator(Box::into_raw(Box::new(budget.clone())), &VTABLE) };
+    (allocator, budget)
+}
