+// A skipped whole-call import must not change shared keyword metadata, run
+// literal constructors, or hide conversion failures. Only core macros whose
+// resolved first formal is unused may take this path, at declaration frontier
+// zero. Positional arguments still use the normal independent import/snapshot.
+fn elidable_call_data(
+    data: &Datum,
+    remaining: &mut usize,
+    depth: usize,
+    control: &crate::evaluator::ExecutionControl,
+) -> bool {
+    use crate::compiler_data::DatumKind as D;
+    if depth == 0 || *remaining == 0 {
+        return false;
+    }
+    if *remaining & 1023 == 0 && control.poll().is_err() {
+        return false;
+    }
+    *remaining -= 1;
+    if matches!(data.kind(), D::CompilerLiteral { .. }) {
+        return false;
+    }
+    if let Some(metadata) = data.metadata() {
+        // Keywords are interned; a later argument's metadata may already be
+        // visible when an earlier argument is snapshotted. Scalar metadata
+        // also has an observable bridge-conversion failure.
+        if !matches!(data.kind(), D::Symbol(_) | D::Collection { .. })
+            || !elidable_call_data(&metadata, remaining, depth - 1, control)
+        {
+            return false;
+        }
+    }
+    match data.kind() {
+        D::Collection { children, .. } => children
+            .iter()
+            .all(|child| elidable_call_data(child, remaining, depth - 1, control)),
+        _ => true,
+    }
+}
