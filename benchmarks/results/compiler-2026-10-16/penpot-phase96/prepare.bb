(require '[babashka.fs :as fs] '[clojure.string :as str])
(def here (fs/parent *file*))
(def touch-vendor "(p/shell \"touch\" (str (fs/file project \"vendor/rquickjs-sys/build.rs\")) (str (fs/file project \"vendor/rquickjs-sys/quickjs/quickjs.c\")))\n")
(spit (fs/file here "validate.bb")
  (-> (slurp "/private/tmp/light-cljs-phase85/validate.bb")
      (str/replace "(p/shell {:dir (str project)} \"cargo\" \"fmt\")" (str touch-vendor "(p/shell {:dir (str project)} \"cargo\" \"fmt\")"))
      (str/replace "shared compiler storage" "shared interrupt scheduler")
      (str/replace "(logged \"tests-v8-4threads\" \"cargo\" \"test\" \"--\" \"--test-threads=4\")"
                   "(logged \"tests-v8-default\" \"cargo\" \"test\")")))
(spit (fs/file here "run.bb")
  (-> (slurp "/private/tmp/light-cljs-phase85/run.bb")
      (str/replace "(p/shell {:dir (str project)} \"cargo\" \"fmt\")" (str touch-vendor "(p/shell {:dir (str project)} \"cargo\" \"fmt\")"))
      (str/replace "light-cljs-compact-program-capacity" "light-cljs-shared-watchdog")
      (str/replace " \"LIGHT_V8_STATS\" \"1\"" "")))
(spit (fs/file here "clean-bench.bb")
  (str/replace (slurp "/private/tmp/light-cljs-phase85/clean-bench.bb")
               "light-cljs-compact-program-capacity" "light-cljs-shared-watchdog"))
