(require '[babashka.fs :as fs] '[clojure.string :as str])
(def here (fs/parent *file*))
(def label (or (first *command-line-args*) "main-none"))
(def output-root (or (second *command-line-args*) (str here)))
(def before (str/split-lines (slurp (str "/private/tmp/light-cljs-phase100/production/" label ".js"))))
(def after (str/split-lines (slurp (fs/file output-root (str label ".js")))))
(assert (= (count before) (count after)))
(def counts (atom {:assignable-locals 0 :var-destructuring 0 :unchanged 0}))
(doseq [[line old new] (map vector (range 1 (inc (count before))) before after)]
  (cond
    (= old new) (swap! counts update :unchanged inc)
    (and (re-find #"^\s+const __light0_l\d+ = " old)
         (= new (str/replace-first old "const " "let   ")))
    (swap! counts update :assignable-locals inc)
    (and (re-find #"^\s+var \{" old)
         (= new (-> old (str/replace-first "var " "( ")
                        (str/replace #";$" ");"))))
    (swap! counts update :var-destructuring inc)
    :else (throw (ex-info "Unexpected output change" {:line line :old old :new new}))))
(spit (fs/file output-root (str label "-output-audit.edn")) (pr-str @counts))
(when (empty? *command-line-args*)
  (spit (fs/file here "output-audit.edn") (pr-str @counts)))
(prn @counts)
