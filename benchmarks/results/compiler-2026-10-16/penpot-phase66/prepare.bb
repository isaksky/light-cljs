(require '[babashka.fs :as fs] '[babashka.process :as p] '[clojure.string :as str])
(def here (fs/parent *file*))
(def scratch (fs/file here "patch-inputs"))
(doseq [[side root] [["before" "/private/tmp/light-cljs-phase58/project"] ["after" "/private/tmp/light-cljs-phase65/project"]]
        file ["compiler_bootstrap.rs" "macro_host.rs"]]
  (fs/create-dirs (fs/file scratch side "src"))
  (fs/copy (fs/file root "src" file) (fs/file scratch side "src" file) {:replace-existing true}))
(def delta (p/shell {:dir (str scratch) :out :string :continue true} "git" "diff" "--no-index" "--" "before" "after"))
(assert (= 1 (:exit delta)))
(def patch (-> (:out delta) (str/replace "a/before/" "a/") (str/replace "b/after/" "b/")))
(spit (fs/file here "unused-core-form.patch") patch)
(p/shell {:dir (str (fs/file here "project")) :in patch} "git" "apply" "-")
(spit (fs/file here "run.bb") (-> (slurp "/private/tmp/light-cljs-phase62/run.bb")
  (str/replace "quickjs-replay" "quickjs-unused-form")
  (str/replace "QuickJS replay trial" "QuickJS unused form trial")
  (str/replace "(str (fs/file project \"src/main.rs\")))" "(str (fs/file project \"src/main.rs\")) (str (fs/file project \"build.rs\")))")))
