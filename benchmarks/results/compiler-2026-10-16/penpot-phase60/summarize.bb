(require '[cheshire.core :as json] '[babashka.fs :as fs] '[clojure.string :as str])
(def here (fs/parent *file*))
(def raw (json/parse-string (slurp (fs/file here "cpu-profile.json")) true))
(assert (not (:error raw)) (pr-str (:error raw)))
(def profile (get-in raw [:result :profile]))
(assert (seq (:nodes profile)))
(spit (fs/file here "main.cpuprofile") (json/generate-string profile))
(def nodes (into {} (map (juxt :id identity)) (:nodes profile)))
(def parents (into {} (for [n (:nodes profile) child (:children n)] [child (:id n)])))
(def weighted (map vector (:samples profile) (:timeDeltas profile)))
(defn signature [id] (let [f (:callFrame (nodes id))] [(:functionName f) (:url f) (:scriptId f) (:lineNumber f) (:columnNumber f)]))
(def total (- (:endTime profile) (:startTime profile)))
(def self-times (reduce (fn [out [id us]] (update out (signature id) (fnil + 0) us)) {} weighted))
(defn ancestry [id] (take-while some? (iterate parents id)))
(def inclusive (reduce (fn [out [id us]] (reduce #(update %1 %2 (fnil + 0) us) out (set (map signature (ancestry id))))) {} weighted))
(def summary {:elapsed-seconds (/ total 1e6) :samples (count (:samples profile))
              :self-top (take 80 (sort-by val > self-times))
              :inclusive-top (take 80 (sort-by val > inclusive))})
(spit (fs/file here "summary.edn") (pr-str summary))
(doseq [[label times] [["SELF" self-times] ["INCLUSIVE" inclusive]]]
  (println label)
  (doseq [[sig us] (take 45 (sort-by val > times))]
    (println (format "%7.3fs %5.1f%%" (/ us 1e6) (* 100.0 (/ us total))) (pr-str sig))))
