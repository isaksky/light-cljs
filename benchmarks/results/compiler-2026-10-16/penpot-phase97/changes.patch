--- /dev/null
+++ b/src/v8_stack.cc
@@ -0,0 +1,17 @@
+// The pinned rusty_v8 bindings expose the initial ResourceConstraints boundary,
+// but not Isolate::SetStackLimit for refreshing an outer operation's boundary.
+#if defined(__clang__) || defined(__GNUC__)
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wunused-parameter"
+#pragma GCC diagnostic ignored "-Wcomment"
+#endif
+#include "v8-isolate.h"
+#if defined(__clang__) || defined(__GNUC__)
+#pragma GCC diagnostic pop
+#endif
+
+extern "C" void light_cljs_v8_set_stack_limit(v8::Isolate* isolate,
+                                             uintptr_t boundary) {
+  isolate->SetStackLimit(boundary);
+}
+
diff --git a/after/src/v8_stack.rs b/src/v8_stack.rs
new file mode 100644
index 0000000..76ad996
--- /dev/null
+++ b/src/v8_stack.rs
@@ -0,0 +1,72 @@
+//! An engine stack budget is relative to the outer operation's native frame.
+//! Clamp it to the owning thread's OS stack bounds, including unwind headroom.
+use crate::evaluator::EvalError;
+
+pub(super) struct StackLimit {
+    low: usize,
+    high: usize,
+    bytes: usize,
+}
+
+unsafe extern "C" {
+    fn light_cljs_v8_set_stack_limit(isolate: v8::UnsafeRawIsolatePtr, boundary: usize);
+    fn light_cljs_thread_stack_bounds(low: *mut usize, high: *mut usize) -> bool;
+}
+
+impl StackLimit {
+    pub(super) fn new(bytes: usize) -> Result<Self, EvalError> {
+        let (low, high) = bounds()?;
+        let limit = Self { low, high, bytes };
+        limit.boundary()?;
+        Ok(limit)
+    }
+
+    pub(super) fn boundary(&self) -> Result<*mut u32, EvalError> {
+        let marker = 0_u32;
+        let here = std::hint::black_box(&marker) as *const u32 as usize;
+        let floor = self.low.checked_add(64 * 1024).ok_or_else(exhausted)?;
+        if !(floor..self.high).contains(&here) {
+            return Err(exhausted());
+        }
+        // A zero configured limit means no additional engine cap, as in
+        // QuickJS. The OS stack boundary still cannot safely be crossed.
+        let requested = if self.bytes == 0 {
+            floor
+        } else {
+            here.saturating_sub(self.bytes)
+        };
+        let boundary = requested.max(floor).checked_add(3).ok_or_else(exhausted)? & !3;
+        if boundary >= here {
+            return Err(exhausted());
+        }
+        Ok(std::ptr::with_exposed_provenance_mut(boundary))
+    }
+
+    pub(super) fn refresh(&self, isolate: &mut v8::Isolate) -> Result<(), EvalError> {
+        let boundary = self.boundary()?;
+        // SAFETY: the !Send evaluator stays on the thread whose bounds were
+        // recorded. boundary checks this operation's frame and leaves native
+        // unwind space. V8 compares the address; it never dereferences it.
+        unsafe {
+            light_cljs_v8_set_stack_limit(isolate.as_raw_isolate_ptr(), boundary as usize);
+        }
+        Ok(())
+    }
+}
+
+fn exhausted() -> EvalError {
+    EvalError("JavaScript session stack limit exhausted".into())
+}
+
+fn bounds() -> Result<(usize, usize), EvalError> {
+    let (mut low, mut high) = (0, 0);
+    // SAFETY: both outputs point to writable pointer-sized values. The shim
+    // queries only the calling thread and rejects unsupported platforms.
+    if unsafe { light_cljs_thread_stack_bounds(&mut low, &mut high) } && low < high {
+        Ok((low, high))
+    } else {
+        Err(EvalError(
+            "V8 stack bounds are unavailable on this thread".into(),
+        ))
+    }
+}
diff --git a/after/src/v8_thread_stack.cc b/src/v8_thread_stack.cc
new file mode 100644
index 0000000..34dfdf7
--- /dev/null
+++ b/src/v8_thread_stack.cc
@@ -0,0 +1,44 @@
+// Native thread stack bounds, independent of the JavaScript engine.
+#include <cstdint>
+#if defined(__APPLE__) || defined(__linux__)
+#include <pthread.h>
+#elif defined(_WIN32)
+#ifndef _WIN32_WINNT
+#define _WIN32_WINNT 0x0602
+#endif
+#include <windows.h>
+#endif
+
+extern "C" bool light_cljs_thread_stack_bounds(uintptr_t* low,
+                                               uintptr_t* high) {
+#if defined(__APPLE__)
+  auto thread = pthread_self();
+  *high = reinterpret_cast<uintptr_t>(pthread_get_stackaddr_np(thread));
+  size_t size = pthread_get_stacksize_np(thread);
+  if (size > *high) return false;
+  *low = *high - size;
+#elif defined(__linux__)
+  pthread_attr_t attributes;
+  if (pthread_getattr_np(pthread_self(), &attributes) != 0) return false;
+  void* address = nullptr;
+  size_t size = 0;
+  int result = pthread_attr_getstack(&attributes, &address, &size);
+  pthread_attr_destroy(&attributes);
+  if (result != 0) return false;
+  *low = reinterpret_cast<uintptr_t>(address);
+  if (size > UINTPTR_MAX - *low) return false;
+  *high = *low + size;
+#elif defined(_WIN32)
+  ULONG_PTR committed_low, stack_high;
+  GetCurrentThreadStackLimits(&committed_low, &stack_high);
+  // Query the reservation base explicitly, without relying on undocumented TEB
+  // offsets. The system stack bounds do not measure physical committed bytes.
+  MEMORY_BASIC_INFORMATION memory;
+  if (VirtualQuery(&memory, &memory, sizeof(memory)) != sizeof(memory)) return false;
+  *low = reinterpret_cast<uintptr_t>(memory.AllocationBase);
+  *high = stack_high;
+#else
+  return false;
+#endif
+  return *low != 0 && *low < *high;
+}
