(require '[babashka.fs :as fs] '[babashka.process :as p])
(def here (fs/parent *file*))
(def program (fs/file here "archive-marker.cc"))
(spit program "extern \"C\" void light_v8_backing_store_budget_abi_v1();\nint main() { light_v8_backing_store_budget_abi_v1(); }\n")
(def result (p/shell {:out :string :err :out :continue true} "c++" (str program)
  "/private/tmp/light-cljs-phase108/frozen-engine/librusty_v8.a" "-o" (str (fs/file here "unexpected-marker"))))
(spit (fs/file here "archive-marker-negative-control.log") (:out result))
(assert (not (zero? (:exit result))))
(assert (re-find #"light_v8_backing_store_budget_abi_v1" (:out result)))
(println "An archive without the patched ABI marker is rejected by the linker")
