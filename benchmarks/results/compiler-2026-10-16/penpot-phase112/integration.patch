+                })
+            })
+            .unwrap();
+        assert_eq!(budget.used(), 1048576, "{source}");
+        drop(evaluator);
+        assert_eq!(budget.used(), 1048576, "native owner: {source}");
+        drop(store);
+        assert_eq!(budget.used(), 0, "last native owner: {source}");
+        assert_eq!(Arc::strong_count(&budget), 1, "allocator owner: {source}");
+    }
+}
