+    fn decode_node<'s>(
+        &mut self,
+        scope: &mut PinScope<'s, '_>,
+        descriptor: Local<'s, v8::Array>,
+        control: &ExecutionControl,
+        depth: usize,
+        remaining: &mut usize,
+        snapshot: bool,
+    ) -> Result<(Datum, Datum), EvalError> {
