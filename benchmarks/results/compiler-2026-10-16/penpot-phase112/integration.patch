+struct MemoryGuard {
+    handle: v8::IsolateHandle,
+    control: ExecutionControl,
+    buffers: Arc<buffers::Budget>,
+    maximum: usize,
+    adaptive: bool,
+    #[cfg(test)]
+    growths: Cell<usize>,
