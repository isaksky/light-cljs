#!/usr/bin/env bb
;; Pants build cljs.core coverage (light-cljs-644).
;;
;; Lists every public var, type and protocol of the pinned cljs.core
;; (research/clojurescript), exercises each one inside a macro on the Pants
;; build and on the QuickJS reference, and compares the two answers. It also
;; builds the protocol x value-kind matrix (`satisfies?` of every core
;; protocol on one value of each kind), counts references to every item in
;; Penpot (research/penpot-light), its vendored libraries and the generated
;; 200k project (research/cljs-200k), and writes the result between the
;; markers in docs/native-macros.md.
;;
;;   bb benchmarks/pants-core-coverage.bb            build both CLIs, probe, check, rewrite the doc
;;   bb benchmarks/pants-core-coverage.bb --check    probe and check only; the doc is not touched
;;   --no-build                reuse target/core-coverage/{pants,quickjs}
;;   --accept-regressions      rewrite the doc even if an item regressed
;;
;; The guard: an item (or matrix cell) the doc's current table records as
;; supported that is now unsupported makes the script exit 1, and the doc is
;; then left as it was.
(require '[babashka.fs :as fs]
         '[babashka.process :as p]
         '[cheshire.core :as json]
         '[clojure.string :as str]
         '[edamame.core :as e])

(def repo (str (fs/parent (fs/parent (fs/absolutize *file*)))))
(def work (str (fs/path repo "target/core-coverage")))
(def doc-file (str (fs/path repo "docs/native-macros.md")))
(def cljs-root (str (fs/path repo "research/clojurescript")))
(def begin-marker "<!-- BEGIN pants-core-coverage: generated by benchmarks/pants-core-coverage.bb; do not edit -->")
(def end-marker "<!-- END pants-core-coverage -->")
(def args (set *command-line-args*))

;; ---------------------------------------------------------------- inventory

(defn read-forms [file features]
  (e/parse-string-all (slurp file)
                      {:all true :read-cond :allow :features features
                       :readers (fn [_] identity)
                       :auto-resolve (fn [x] (if (= x :current) 'cljs.core (symbol (str x))))}))

(defn public? [sym] (not (:private (meta sym))))

(defn top-level [forms]
  (mapcat (fn [f] (if (and (seq? f) (#{'do 'when 'if} (first f)))
                    (top-level (filter seq? (rest f)))
                    [f]))
          forms))

(defn arglists
  "The parameter vectors of a defn or protocol method signature body."
  [body]
  (let [body (drop-while #(or (string? %) (map? %)) body)]
    (cond (vector? (first body)) [(first body)]
          :else (keep #(when (and (seq? %) (vector? (first %))) (first %)) body))))

(defn inventory
  "Every public var, type, protocol and macro the pinned sources under
  `root` define."
  [root]
  (let [core (top-level (read-forms (str root "/src/main/cljs/cljs/core.cljs") #{:cljs}))
        macro-forms (mapcat #(top-level (read-forms (str root "/src/main/clojure/cljs/core.cljc") %))
                            [#{:clj} #{:cljs}])
        values (for [f core :when (seq? f)
                     :let [[head n & body] f]
                     :when (and (symbol? n) (public? n))
                     item (case head
                            (def defonce goog-define) [{:name (str n) :kind :value :arglists (when (and (seq? (last body)) (= 'fn (first (last body)))) (arglists (rest (last body))))}]
                            defn [{:name (str n) :kind :value :arglists (arglists body)}]
                            defprotocol (cons {:name (str n) :kind :protocol}
                                              (for [s body :when (seq? s)]
                                                {:name (str (first s)) :kind :method :protocol (str n)
                                                 :arglists (filter vector? (rest s))}))
                            (deftype defrecord) [{:name (str n) :kind :type :fields (first body)}
                                                 {:name (str "->" n) :kind :value :factory (str n)
                                                  :arglists [(first body)]}]
                            nil)]
                 item)
        macros (for [f macro-forms
                     :when (and (seq? f) (symbol? (second f)) (public? (second f))
                                (or (#{'core/defmacro 'defmacro} (first f))
                                    ;; defmacro is a function made a macro by setMacro;
                                    ;; defn a def with :macro metadata.
                                    (and (= 'core/defn (first f)) (= 'defmacro (second f)))
                                    (and (#{'def 'core/def} (first f)) (:macro (meta (second f))))))]
                 {:name (str (second f)) :kind :macro})]
    (->> (concat values macros)
         (reduce (fn [m item] (if (contains? m [(:name item) (:kind item)]) m (assoc m [(:name item) (:kind item)] item))) (array-map))
         vals
         (sort-by (juxt (comp {:value 0 :method 1 :type 2 :protocol 3 :macro 4} :kind) :name))
         vec)))

