(defn call-probe [{:keys [name arglists protocol]}]
  (let [fixed (fn [params] (vec (take-while #(not= '& %) params)))
        lists (sort-by count (map fixed arglists))
        params (or (first (filter seq lists)) (first lists))]
    (cond (nil? params) (str "(cljs.core/" name ")")
          :else (str "(cljs.core/" name " "
                     (str/join " " (map-indexed (fn [i p] (if (and protocol (zero? i))
                                                            (get protocol-samples protocol "[1]")
                                                            (sample p)))
                                                params))
                     ")"))))

;; Probes that call what used to be checked only for presence (fn?), and
;; probes that need a top-level form first ({:top forms :expr expr}). A
;; value-probes entry that only asks fn? or answers true is ignored: the
;; item is then called with arguments from its parameter names.
