#!/usr/bin/env bb
;; Tests for benchmarks/pants-core-coverage.bb: bb benchmarks/pants-core-coverage-test.bb
;; The inventory test reads the pinned research/clojurescript checkout; the
;; build test runs Cargo on a tiny throwaway crate. No light-cljs build runs.
(require '[clojure.test :refer [deftest is run-tests]])
;; Loading the script supplies its functions without running -main.
(load-file (str (.getParent (java.io.File. *file*)) "/pants-core-coverage.bb"))

(deftest inventory-includes-public-definition-shapes
  (let [items (set (map (juxt :name :kind) (inventory cljs-root)))]
    ;; goog-define in core.cljs
    (is (contains? items ["*target*" :value]))
    (is (contains? items ["*global*" :value]))
    (is (contains? items ["LITE_MODE" :value]))
    ;; def with :macro metadata, and defmacro made a macro by setMacro, in core.cljc
    (is (contains? items ["defn" :macro]))
    (is (contains? items ["defmacro" :macro]))
    ;; ordinary shapes
    (is (contains? items ["fnext" :value]))
    (is (contains? items ["ISeq" :protocol]))
    (is (contains? items ["-first" :method]))
    (is (contains? items ["MapEntry" :type]))
    (is (contains? items ["->MapEntry" :value]))
    (is (contains? items ["when-let" :macro]))
    (is (not (contains? items ["base-type" :macro])) "private definitions are left out")))

(deftest every-item-is-probed-by-calling-it
  (doseq [item (inventory cljs-root)
          :let [{:keys [expr]} (probe-of item)]]
    (is (string? expr) (:name item))
    (is (not (str/starts-with? expr "(fn? ")) (str (:name item) " is only checked for presence: " expr))))

(deftest reference-failure-preserves-pants-gap
  (let [item {:name "vector-lite" :kind :value}
        unresolved "COMPILE light-cljs: 4:1: macro expansion: generated by let: unresolved symbol: cljs.core/vector-lite (bytes 69..299)"]
    (is (= "unsupported" (:status (status-of item unresolved unresolved #{}))))
    (is (str/includes? (:note (status-of item unresolved unresolved #{})) "unresolved symbol: cljs.core/vector-lite"))
    (is (= "unsupported" (:status (status-of item "ERR unsupported operation: native macro runtime core.x" "COMPILE x" #{}))))
    (is (= "unverified" (:status (status-of item "[1]" "COMPILE x" #{}))))
    (is (= "native" (:status (status-of item "[1]" "[1]" #{}))))
    (is (= "bootstrap" (:status (status-of {:name "simple-benchmark" :kind :macro} "true" "true" #{"simple-benchmark"}))))))

(deftest matching-errors-do-not-preserve-support
  (let [item {:name "nth" :kind :value}
        error "ERR Index out of bounds"]
    (is (= "unsupported" (:status (status-of item error error #{}))))
    (is (= "unsupported" (:status (status-of item "COMPILE same" "COMPILE same" #{})))))
  (let [cells [{:protocol "APersistentVector" :kind "vector" :pants "COMPILE unresolved" :reference "COMPILE unresolved"}
               {:protocol "ISeq" :kind "list" :pants "ERR boom" :reference "ERR boom"}
               {:protocol "ISeq" :kind "vector" :pants "false" :reference "false"}
               {:protocol "ISeq" :kind "cons" :pants "false" :reference "true"}]
        now (for [c cells :when (cell-agrees? c)] [(:protocol c) (:kind c)])]
    (is (= [["ISeq" "vector"]] now))
    (is (= [["APersistentVector" "vector"] ["ISeq" "list"]]
           (regressed #{["APersistentVector" "vector"] ["ISeq" "list"] ["ISeq" "vector"]} now))
        "a cell that used to agree and now fails the same way on both builds is a regression")))

(deftest callable-stub-is-not-supported
  ;; set-print-fn! stays a function but its call fails: the probe calls it,
  ;; so the answer is the failure, and the item is a gap.
  (let [item {:name "set-print-fn!" :kind :value :arglists '[[f]]}
        {:keys [expr]} (probe-of item)]
    (is (str/includes? expr "(set-print-fn! "))
    (is (= "unsupported" (:status (status-of item "ERR unsupported operation: native macro runtime core.setPrintFn"
                                             "[\"x\"]" #{})))))
  (let [factory {:name "->Atom" :kind :value :factory "Atom" :arglists '[[state meta validator watches]]}]
    (is (= "(some? (cljs.core/->Atom nil nil nil nil))" (:expr (probe-of factory))))))

(deftest pr-writer-probe-invokes-the-method
  (let [expr (:expr (probe-of {:name "-pr-writer" :kind :method}))
        form (e/parse-string expr {:all true})
        call (some #(when (and (seq? %) (= 'cljs.core/-pr-writer (first %))) %)
                   (tree-seq coll? seq form))]
    (is (= '(cljs.core/-pr-writer [1 "a"] w
                                {:flush-on-newline true :readably true :meta false :dup false})
           call))
    (is (= '(apply str b) (last form)) "the probe observes what the writer receives")))

(deftest usage-counts-higher-order-references
  (let [{:keys [ref all]} (count-tokens (strip-text (str "(keep not-empty children)\n"
                                                         "(map clj->js xs)\n"
                                                         "(apply max-key count xs)\n"
                                                         "( not-empty x)\n"
                                                         "(cljs.core/run! f xs)\n"
                                                         "(let [type (:type x) {:keys [run!]} m] (str type))\n"
                                                         "; (not-empty commented)\n"
                                                         "\"(not-empty in a string)\"")))]
    (is (= 2 (ref "not-empty")))
    (is (= 1 (ref "clj->js")))
    (is (= 1 (ref "max-key")))
    (is (= 1 (ref "apply")))
    (is (= 1 (ref "run!")) "the destructured local is not a reference")
    (is (= 1 (ref "type")) "only the use in (str type), not the binding")
    (is (= 2 (all "run!")))))

(deftest usage-counts-collection-references
  (let [{:keys [ref all]}
        (count-tokens
         (strip-text (str "{:wfn inst-ms :convert [cljs.core/clj->js]} [not-empty]\n"
                          "(let [type \"a string\" f clj->js\n"
                          "      {:keys [run!] :or {run! inst-ms}} m\n"
                          "      [map & rest] xs] [f type])\n"
                          "(fn named [filter {:keys [keep] :or {keep not-empty}}] [filter])\n"
                          "(defn clj->js [not-empty {:keys [inst-ms]}] [not-empty])\n"
                          "(for [type xs :let [f clj->js] :when (not-empty xs)] [f])\n"
                          "#{not-empty} #?(:clj [inst-ms] :cljs {:wfn inst-ms})")))]
    (is (= 4 (ref "inst-ms")) "map values, defaults and both reader-conditional branches")
    (is (= 3 (ref "clj->js")) "collection elements and initializers, excluding the defn name")
    (is (= 5 (ref "not-empty")) "collection, function body, default and comprehension expressions")
    (is (= 1 (ref "type")) "binding names are excluded even after a string initializer")
    (is (= 1 (ref "filter")) "function parameters are excluded; their uses still count")
    (doseq [n ["run!" "map" "rest" "keep"]]
      (is (nil? (ref n)) (str n " only occurs in binding declarations")))
    (is (= 5 (all "inst-ms")))
    (is (= 2 (all "run!")))))

(deftest usage-keeps-literal-slots-and-ignores-comment-contents
  (let [refs (:ref (count-tokens
                   (strip-text (str "; An unmatched quote \" in a comment\n"
                                    "(let [type \"ignored not-empty\" f clj->js\n"
                                    "      run! \\u200B g inst-ms\n"
                                    "      keep #\"a;not-empty\" h not-empty] [type])"))))]
    (is (= {"let" 1 "clj->js" 1 "inst-ms" 1 "not-empty" 1 "type" 1} refs)))
  (is (= 1 (get-in (count-tokens (strip-text "{:label\"s\" :wfn inst-ms} [\"s\"not-empty]")) [:ref "not-empty"]))
      "a removed literal still separates adjacent tokens"))

(deftest usage-distinguishes-other-binding-forms
  (doseq [[source expected]
          [["(loop [not-empty [inst-ms]] [not-empty])" {"not-empty" 1 "inst-ms" 1}]
           ["(letfn [(not-empty [inst-ms] [inst-ms])] [not-empty])" {"not-empty" 1 "inst-ms" 1}]
           ["(defn f ([not-empty] [not-empty]) ([inst-ms type] {:x type}))" {"not-empty" 1 "type" 1}]
           ["(defprotocol P (-first [not-empty] [not-empty type]))" {}]
           ["(deftype T [not-empty] P (-first [this inst-ms] [inst-ms]))" {"inst-ms" 1}]
           ["`(let ~bindings ~@body) `(for ~bindings ~@body) `(letfn ~bindings ~@body)" {}]]
          :let [refs (:ref (count-tokens (strip-text source)))]]
    (is (= expected (select-keys refs ["not-empty" "inst-ms" "type"])) source)))

(deftest usage-rejects-missing-corpora
  (let [dir (fs/create-temp-dir {:dir (fs/create-dirs (fs/path repo "target")) :prefix "core-coverage-usage-test-"})
        baseline "Preserve this coverage baseline.\n"
        doc (str (fs/path dir "coverage.md"))
        roots [[:penpot ["penpot" "optional-penpot-root"]]
               [:vendored ["vendor"]] [:generated ["generated"]]]]
    (try
      (spit doc baseline)
      (doseq [[_ [root]] roots]
        (fs/create-dirs (fs/path dir root))
        (spit (str (fs/path dir root "source.cljs")) "{:wfn inst-ms}"))
      (let [calls (atom [])]
        (with-redefs [repo (str dir) doc-file doc usage-roots roots args #{}
                      build! (fn [& _] (swap! calls conj :build))
                      run-all (fn [& _] (swap! calls conj :probe) {})]
          (is (= {:penpot 1 :vendored 1 :generated 1} (update-vals (usage) :files)))
          (doseq [[corpus [root]] roots
                  state [:missing :empty]]
            (fs/delete-tree (fs/path dir root))
            (when (= :empty state)
              (fs/create-dirs (fs/path dir root))
              (spit (str (fs/path dir root "README.md")) "No source files."))
            (doseq [run [usage -main]
                    :let [error (try (run) nil (catch clojure.lang.ExceptionInfo ex ex))]]
              (is (= corpus (:corpus (ex-data error))) (str corpus " " state))
              (is (str/includes? (or (ex-message error) "") "Restore these research sources"))
              (is (str/includes? (or (ex-message error) "") (str (fs/path dir root)))))
            (is (= baseline (slurp doc)) "invalid corpora cannot overwrite the baseline")
            (is (empty? @calls) "validation precedes building and probing")
            (fs/create-dirs (fs/path dir root))
            (spit (str (fs/path dir root "source.cljs")) "{:wfn inst-ms}"))))
      (finally (fs/delete-tree dir)))))

(deftest core-coverage-build-ignores-stale-binaries
  (let [dir (fs/create-temp-dir {:dir (fs/create-dirs (fs/path repo "target")) :prefix "core-coverage-build-test-"})]
    (try
      (fs/create-dirs (fs/path dir ".cargo"))
      (fs/create-dirs (fs/path dir "src"))
      (fs/create-dirs (fs/path dir "target/debug"))
      (spit (str (fs/path dir "Cargo.toml"))
            "[package]\nname = \"light-cljs\"\nversion = \"0.0.0\"\nedition = \"2021\"\n[workspace]\n[features]\ndefault = [\"v8\"]\nv8 = []\nbbp-macros = []\nquickjs = []\n")
      (spit (str (fs/path dir "Cargo.lock")) "version = 3\n[[package]]\nname = \"light-cljs\"\nversion = \"0.0.0\"\n")
      (spit (str (fs/path dir "src/main.rs"))
            "fn main() { assert!(!cfg!(feature = \"v8\")); println!(\"{}\", if cfg!(feature = \"bbp-macros\") { \"pants\" } else if cfg!(feature = \"quickjs\") { \"quickjs\" } else { \"none\" }); }\n")
      (spit (str (fs/path dir ".cargo/config.toml"))
            "[build]\ntarget = \"invalid-configured-target\"\ntarget-dir = \"wrong-configured-directory\"\n")
      (spit (str (fs/path dir "target/debug/light-cljs")) "stale-binary")
      (let [env (assoc (into {} (System/getenv))
                       "CARGO_TARGET_DIR" (str (fs/path dir "wrong-env-directory"))
                       "CARGO_BUILD_TARGET" "invalid-env-target"
                       "CARGO_BUILD_JOBS" "2")]
        (build! (str dir) :env env)
        (doseq [name ["pants" "quickjs"]]
          (is (= (str name "\n") (:out (p/shell {:out :string} (str (fs/path dir "target/core-coverage" name))))))))
      (is (= "stale-binary" (slurp (str (fs/path dir "target/debug/light-cljs")))))
      (finally (fs/delete-tree dir)))))

(let [{:keys [fail error]} (run-tests)]
  (System/exit (if (zero? (+ fail error)) 0 1)))
