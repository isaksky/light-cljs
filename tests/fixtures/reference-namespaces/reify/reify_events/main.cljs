(ns reify-events.main (:require [reify-events.api :as p] [reify-events.events :as e]))
(let [a (e/increment-event 3)
      b (e/increment-event 5)
      tagged (with-meta a {:event :increment})
      update p/-update
      effects (atom [])
      state (update tagged {:total 10})
      watcher (p/-watch tagged state [:tick])]
  (p/-effect tagged state {:emit #(swap! effects conj %)})
  (assert (= {:total 13} state))
  (assert (= [[3 13 1 true]] @effects))
  (assert (= [13 [:tick] 3 1] (take 4 (watcher))))
  (assert (identical? tagged (nth (watcher) 4)))
  (assert (satisfies? p/Marker tagged))
  (assert (implements? p/UpdateEvent tagged))
  (assert (= {:event :increment} (meta tagged)))
  (assert (= "increment:3" (str tagged)))
  (assert (identical? (type a) (type b)))
  (assert (not (identical? a tagged)))
  (assert (= {:total 15} (apply update [b {:total 10}])))
  (assert (= [10 [] 5 1] (take 4 ((p/-watch b {:total 10} [])))))
  (assert (= {:total 16} (update a state)))
  (assert (= 2 (nth (watcher) 3)))
  (js/console.log "events-ok" (pr-str state) (pr-str @effects)))
