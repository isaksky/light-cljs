(ns once.macros)
(defonce registry (atom []))
(defonce registry (atom [:replaced]))
(def effects (atom 0))
(def pending (do (swap! effects inc) 42))
(defonce pending 99)
(declare declared)
(defonce declared 7)
(defmacro register [k] (swap! registry conj [k (count @registry) pending declared @effects]) k)
(defmacro snapshot [] (list 'quote @registry))
