(ns residualbody.case6 (:require [clojure.set] [clojure.string] [cljs.reader] [goog.object]))
(defn run [] (do (do (let [         a (try             (cljs.reader/read-string "{:a 1 :b 2 :c 3 :a 1}")             :failed-to-throw             (catch js/Error e (ex-message e)))                  b (try             (cljs.reader/read-string "{:a 1 :b 2 :c 3 :d 4 :e 5 :f 6 :h 7 :i 8 :a 1}")             :failed-to-throw             (catch js/Error e (ex-message e)))                  c (try             (cljs.reader/read-string "#{:a :b :c :d :a}")             :failed-to-throw             (catch js/Error e (ex-message e)))                  d (try             (cljs.reader/read-string "#{:a :b :c :d :e :f :g :h :i :a}")             :failed-to-throw             (catch js/Error e (ex-message e)))         ]     (assert (= "Map literal contains duplicate key: :a" a))     (assert (= "Map literal contains duplicate key: :a" b))          (assert (= "Set literal contains duplicate key: :a" c))     (assert (= "Set literal contains duplicate key: :a" d))     ) true)))
