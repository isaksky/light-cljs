(ns records.main (:require [records.model :as m] [records.other :as o]))
(let [a (m/Item. 2) b (m/saved 2) c (m/saved-map {:x 2})
      old m/original updated (assoc old :x 4) plain (dissoc a :x)]
  (assert (= a b c))
  (assert (= 12 (m/value a)))
  (assert (= 1 (m/value old)))
  (assert (= 14 (m/value updated)))
  (assert (instance? m/old-type old))
  (assert (instance? m/Item updated))
  (assert (not= a (o/->Item 2)))
  (assert (not (record? plain)))
  (assert (= "#records.model.Item{:x 2}" (pr-str a)))
  (assert (= 7 (get {a 7} c))))
(js/console.log "records-ok")
