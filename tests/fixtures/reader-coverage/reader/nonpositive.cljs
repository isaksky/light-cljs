;; Canonical anonymous reader data computed in application and demanded macro phases.
(ns reader.nonpositive)
(def phase-count (atom 0))
(defn contracts []
  (and
    (= (let [f '#() base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true [] []])
    (= (let [f '#(%0) base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true [] ["p0"]])
    (= (let [f '#(%-1) base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true ["&" "rest"] ["rest"]])
    (= (let [f '#(%-2) base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true [] ["p-2"]])
    (= (let [f '#(%0 %-1) base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true ["&" "rest"] ["p0" "rest"]])
    (= (let [f '#(%0 %-2) base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true [] ["p0" "p-2"]])
    (= (let [f '#(%-1 %& %-1 %&) base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true ["&" "rest"] ["rest" "rest" "rest" "rest"]])
    (= (let [f '#(% %3 %0 %-1 %-2 %& %3 %0) base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true ["p1" "p2" "p3" "&" "rest"] ["p1" "p3" "p0" "rest" "p-2" "rest" "p3" "p0"]])
    (= (let [f '#(%0 %0) base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true [] ["p0" "p0"]])
    (= (let [f '#(%-2 %-2) base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true [] ["p-2" "p-2"]])
    (= (let [f '#(%2 %0) base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true ["p1" "p2"] ["p2" "p0"]])
    (= (let [f '#(%& %0) base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true ["&" "rest"] ["rest" "p0"]])
    (= (let [f (read-string "#()") base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true [] []])
    (= (let [f (read-string "#(%0)") base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true [] ["p0"]])
    (= (let [f (read-string "#(%-1)") base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true ["&" "rest"] ["rest"]])
    (= (let [f (read-string "#(%-2)") base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true [] ["p-2"]])
    (= (let [f (read-string "#(%0 %-1)") base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true ["&" "rest"] ["p0" "rest"]])
    (= (let [f (read-string "#(%0 %-2)") base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true [] ["p0" "p-2"]])
    (= (let [f (read-string "#(%-1 %& %-1 %&)") base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true ["&" "rest"] ["rest" "rest" "rest" "rest"]])
    (= (let [f (read-string "#(% %3 %0 %-1 %-2 %& %3 %0)") base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true ["p1" "p2" "p3" "&" "rest"] ["p1" "p3" "p0" "rest" "p-2" "rest" "p3" "p0"]])
    (= (let [f (read-string "#(%0 %0)") base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true [] ["p0" "p0"]])
    (= (let [f (read-string "#(%-2 %-2)") base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true [] ["p-2" "p-2"]])
    (= (let [f (read-string "#(%2 %0)") base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true ["p1" "p2"] ["p2" "p0"]])
    (= (let [f (read-string "#(%& %0)") base (fn [s] (if (= s '&) "&" (let [n (name s)] (subs n 0 (.indexOf n "__")))))] [(= (first f) 'fn*) (vector? (second f)) (seq? (nth f 2)) (mapv base (second f)) (mapv base (nth f 2))]) [true true true ["&" "rest"] ["rest" "p0"]])
    (let [f '#(%0 %0 %-1 %& %-2 %-2) body (nth f 2)]
      (and (= (first body) (second body))
           (= (nth body 2) (nth body 3) (last (second f)))
           (= (nth body 4) (nth body 5))
           (not= (first body) (nth body 2) (nth body 4))))
    (= (#(vector %-1 %&) 1 2) ['(1 2) '(1 2)])))
(defmacro macro-contract []
  (swap! phase-count inc)
  (list 'quote [(contracts) @phase-count]))
(pr-str [(contracts) (macro-contract) @phase-count])
