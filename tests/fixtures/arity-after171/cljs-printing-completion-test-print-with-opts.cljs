; Complete pinned printing_test body adapter.
(ns cljs.printing-test)

(defn run [observe]
(let [utility-failures (atom []) utility-check (fn [identity value & message] (when-not value (swap! utility-failures conj identity)) value)] (do (do (utility-check "src/test/cljs/cljs/printing_test.cljs::test-print-with-opts::assertion-001" (= (pr-str-with-opts [[1 2 3]] {:more-marker "<MORE-MARKER>" :print-length 0})           "[<MORE-MARKER>]")) (utility-check "src/test/cljs/cljs/printing_test.cljs::test-print-with-opts::assertion-002" (= (pr-str-with-opts [[1 2 3]] {:more-marker "\u2026" :print-length 1})           "[1 \u2026]")) (utility-check "src/test/cljs/cljs/printing_test.cljs::test-print-with-opts::assertion-003" (#{"#{1 2 \u2026}" "#{1 3 \u2026}"            "#{2 1 \u2026}" "#{2 3 \u2026}"            "#{3 1 \u2026}" "#{3 2 \u2026}"}           (pr-str-with-opts [#{1 2 3}] {:more-marker "\u2026" :print-length 2}))) (utility-check "src/test/cljs/cljs/printing_test.cljs::test-print-with-opts::assertion-004" (= (pr-str-with-opts ['(1 2 3)] {:more-marker "\u2026" :print-length 2})           "(1 2 \u2026)")) (utility-check "src/test/cljs/cljs/printing_test.cljs::test-print-with-opts::assertion-005" (#{"{:1 1, :2 2, \u2026}" "{:1 1, :3 3, \u2026}"            "{:2 2, :1 1, \u2026}" "{:2 2, :3 3, \u2026}"            "{:3 3, :1 1, \u2026}" "{:3 3, :2 2, \u2026}"}           (pr-str-with-opts [{:1 1 :2 2 :3 3}] {:more-marker "\u2026" :print-length 2})))) (do (utility-check "src/test/cljs/cljs/printing_test.cljs::test-print-with-opts::assertion-006" (= (pr-str-with-opts [[1 2 3]] {:alt-impl (fn [obj writer opts] ((:fallback-impl opts) obj writer opts))})           "[1 2 3]")) (utility-check "src/test/cljs/cljs/printing_test.cljs::test-print-with-opts::assertion-007" (= (pr-str-with-opts [[1 2 3]] {:alt-impl (fn [obj writer opts] (-write writer (str "<" obj ">")))})           "<[1 2 3]>")) (utility-check "src/test/cljs/cljs/printing_test.cljs::test-print-with-opts::assertion-008" (= (pr-str-with-opts [[:start 1 2 [:middle] 3 4 :end] :standalone] {:alt-impl (fn [obj writer opts]                                                                                         (if (keyword? obj)                                                                                           (-write writer (str "|" (name obj) "|"))                                                                                           ((:fallback-impl opts) obj writer opts)))})           "[|start| 1 2 [|middle|] 3 4 |end|] |standalone|")) (utility-check "src/test/cljs/cljs/printing_test.cljs::test-print-with-opts::assertion-009" (= (pr-str-with-opts [[1 2 3]] {:alt-impl (fn [obj writer opts])})           "")))) (if (empty? @utility-failures) true @utility-failures))
)
run
