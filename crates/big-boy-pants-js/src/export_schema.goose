fn export_name_operand(op: i64) -> bool {
    return match op {
        opcode::GetField => true,
        opcode::PutField => true,
        opcode::DefineField => true,
        opcode::DefineGetter => true,
        opcode::DefineSetter => true,
        opcode::GetGlobal => true,
        opcode::GetGlobalOrUndefined => true,
        opcode::PutGlobal => true,
        opcode::DeclareGlobalVar => true,
        opcode::DeclareGlobalFunction => true,
        opcode::RegExpLiteral => true,
        opcode::SetComputedName => true,
        opcode::DeclareGlobalLet => true,
        opcode::DeclareGlobalConst => true,
        opcode::InitGlobalLexical => true,
        opcode::CheckGlobalVar => true,
        opcode::CheckGlobalFunction => true,
        opcode::DeleteGlobal => true,
        opcode::DeclareGlobalConstValue => true,
        opcode::CheckGlobalLexicalConflict => true,
        opcode::PutGlobalStrict => true,
        opcode::PutFieldStrict => true,
        opcode::NewPrivateName => true,
        _ => false,
    };
}

// The call opcodes that may carry the direct-eval site bit (descriptor
// bit 24, GSP version 3).
fn export_direct_eval_call(op: i64) -> bool {
    return match op {
        opcode::Call => true,
        opcode::CallMethod => true,
        opcode::CallSpread => true,
        opcode::CallMethodSpread => true,
        _ => false,
    };
}

// Stack effect and control flow, from the engine validator's rules:
// bits 0..7 base pops, 8..15 pushes, 16..23 multiplier, 24..27 source of
// the multiplied count (0 none, 1 operand, 2 child captures, 3 form arity),
// 28..31 flow (0 next, 1 jump, 2 branch, 3 catch, 4 end).
fn export_stack_effect(op: i64) -> i64 {
    return match op {
        opcode::Const => 256,
        opcode::Undefined => 256,
        opcode::GetLocal => 256,
