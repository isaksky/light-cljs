fn export_well_known_symbol(index: i64) -> const u8[:] {
    return match index {
        0 => "iterator",
        1 => "asyncIterator",
        2 => "toPrimitive",
        3 => "hasInstance",
        4 => "toStringTag",
        5 => "dispose",
        6 => "asyncDispose",
        7 => "unscopables",
        8 => "species",
        9 => "isConcatSpreadable",
        10 => "match",
        11 => "matchAll",
        12 => "search",
        13 => "replace",
        14 => "split",
        _ => "",
    };
}

// Valid selectors of a ThrowKind or built-in global operand are 0..count;
// -1 for opcodes without such a selector (FormOp has export_form_arity).
fn export_selector_count(op: i64) -> i64 {
    return match op {
        opcode::ThrowError => 5,
        opcode::GetBuiltinGlobal => 50,
        _ => -1,
    };
}
