// Valid selectors of a ThrowKind or built-in global operand are 0..count;
// -1 for opcodes without such a selector (FormOp has export_form_arity).
fn export_selector_count(op: i64) -> i64 {
    return match op {
        42 => 5,
        82 => 50,
        _ => -1,
    };
}
